    {
      "id": "10-fin",
      "index": 10,
      "lines": [
        {
          "cap": "Alan Turing a imaginé l'ordinateur avant qu'il existe.",
          "start": 480.427,
          "end": 484.469
        },
        {
          "cap": "Il a aidé à casser le code d'Enigma.",
          "start": 484.689,
          "end": 487.177
        },
        {
          "cap": "Il a posé la question qui obsède encore les chercheurs en intelligence artificielle.",
          "start": 487.397,
          "end": 491.657
        },
        {
          "cap": "Et son pays l'a condamné pour qui il aimait.",
          "start": 491.877,
          "end": 494.129
        },
        {
          "cap": "Le pardon est arrivé.",
          "start": 494.349,
          "end": 495.501
        },
        {
          "cap": "Mais il n'a jamais pu l'entendre.",
          "start": 496.051,
          "end": 498.332
        }
