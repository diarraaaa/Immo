{
  "total": 501.332,
  "scenes": [
    {
      "id": "00-hook",
      "index": 0,
      "lines": [
        {
          "cap": "En 1952, la Grande-Bretagne condamne un homme qui l'a aidée à gagner la guerre.",
          "start": 0.25,
          "end": 6.141
        },
        {
          "cap": "Son crime ?",
          "start": 6.361,
          "end": 6.995
        },
        {
          "cap": "Avoir aimé un homme.",
          "start": 7.215,
          "end": 8.404
        }
      ],
      "start": 0,
      "end": 8.704,
      "duration": 8.704,
      "beats": [
        0.25,
        6.361,
        7.215
      ],
      "beatEnds": [
        6.141,
        6.995,
        8.404
      ]
    },
    {
      "id": "01-enjeux",
      "index": 1,
      "lines": [
        {
          "cap": "61 ans plus tard, la reine lui accorde son pardon.",
          "start": 8.954,
          "end": 12.609
        },
        {
          "cap": "Entre les deux, il y a une machine secrète, un code réputé incassable, et une pomme à moitié mangée.",
          "start": 12.829,
          "end": 18.739
        },
        {
          "cap": "Il s'appelait Alan Turing.",
          "start": 18.959,
          "end": 20.628
        }
      ],
      "start": 8.704,
      "end": 20.928,
      "duration": 12.224,
      "beats": [
        0.25,
        4.125,
        10.255
      ],
      "beatEnds": [
        3.905,
        10.035,
        11.924
      ]
    },
    {
      "id": "02-boucle",
      "index": 2,
      "lines": [
        {
          "cap": "Tu connais peut-être le film.",
          "start": 21.178,
          "end": 23.294
        },
        {
          "cap": "Tu connais peut-être Enigma.",
          "start": 23.514,
          "end": 25.44
        },
        {
          "cap": "Mais l'histoire complète est plus étrange.",
          "start": 25.66,
          "end": 28.297
        },
        {
          "cap": "Et plus dure.",
          "start": 28.517,
          "end": 28.982
        },
        {
          "cap": "Aujourd'hui, on la raconte du début.",
          "start": 29.202,
          "end": 31.155
        },
        {
          "cap": "Et à la fin, on reviendra sur cette pomme.",
          "start": 31.375,
          "end": 33.522
        },
        {
          "cap": "Parce que personne n'est d'accord sur ce qu'elle veut dire.",
          "start": 34.072,
          "end": 36.69
        }
      ],
      "start": 20.928,
      "end": 36.99,
      "duration": 16.062,
      "beats": [
        0.25,
        2.586,
        4.732,
        7.589,
