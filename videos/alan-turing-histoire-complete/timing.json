    {
      "id": "07-proces",
      "index": 7,
      "lines": [
        {
          "cap": "Janvier 1952.",
          "start": 352.567,
          "end": 354.349
        },
        {
          "cap": "Sa maison, près de Manchester, est cambriolée.",
          "start": 354.469,
          "end": 357.223
        },
        {
          "cap": "Turing porte plainte.",
          "start": 357.343,
          "end": 359.885
        },
        {
          "cap": "Pendant l'enquête, il explique à la police qu'il a une relation avec un jeune homme, Arnold Murray, et que le cambrioleur est une connaissance de Murray.",
          "start": 360.005,
          "end": 366.934
        },
        {
          "cap": "Il ne cache rien.",
          "start": 367.054,
          "end": 369.881
        },
        {
          "cap": "Il ne pense pas avoir fait quelque chose de mal.",
          "start": 370.001,
          "end": 371.978
        },
        {
          "cap": "Mais en Grande-Bretagne, à cette époque, l'homosexualité masculine est un crime.",
          "start": 372.098,
          "end": 376.963
        },
        {
          "cap": "La victime du cambriolage devient l'accusé.",
          "start": 377.513,
          "end": 379.62
        },
        {
          "cap": "Le 31 mars 1952, Turing est reconnu coupable de « grossière indécence ».",
          "start": 379.74,
          "end": 385.769
        },
        {
          "cap": "Le juge lui laisse un choix.",
          "start": 385.889,
          "end": 387.428
        },
        {
          "cap": "La prison.",
          "start": 387.548,
          "end": 389.913
        },
        {
          "cap": "Ou un an de mise à l'épreuve, avec un traitement hormonal destiné à supprimer sa libido.",
          "start": 390.033,
          "end": 394.747
        },
        {
          "cap": "Ce qu'on appellera plus tard une castration chimique.",
          "start": 394.867,
          "end": 397.447
        },
        {
          "cap": "Turing choisit le traitement, pour pouvoir continuer à travailler.",
          "start": 397.567,
          "end": 400.649
        },
        {
          "cap": "Son corps change.",
          "start": 400.769,
          "end": 401.883
        },
        {
          "cap": "Et il perd son habilitation de sécurité.",
          "start": 402.003,
          "end": 404.085
        },
        {
          "cap": "L'homme qui avait cassé les codes de l'ennemi ne peut plus travailler pour les services secrets de son pays.",
          "start": 404.205,
          "end": 408.523
        },
        {
          "cap": "En pleine guerre froide, on le considère comme un risque.",
          "start": 408.643,
          "end": 411.735
        }
      ],
