{
  "total": 516.223,
  "scenes": [
    {
      "id": "00-hook",
      "index": 0,
      "lines": [
        {
          "cap": "En 1952, la Grande-Bretagne condamne un homme qui l'a aidée à gagner la guerre.",
          "start": 0.25,
          "end": 4.911
        },
        {
          "cap": "Son crime ?",
          "start": 5.031,
          "end": 7.458
        },
        {
          "cap": "Avoir aimé un homme.",
          "start": 7.578,
          "end": 8.581
        }
      ],
      "start": 0,
      "end": 8.681,
      "duration": 8.681,
      "beats": [
        0.25,
        5.031,
        7.578
      ],
      "beatEnds": [
        4.911,
        7.458,
        8.581
      ]
    },
    {
      "id": "01-enjeux",
      "index": 1,
      "lines": [
        {
          "cap": "61 ans plus tard, la reine lui accorde son pardon.",
          "start": 8.931,
          "end": 13.144
        },
        {
          "cap": "Entre les deux, il y a une machine secrète, un code réputé incassable, et une pomme à moitié mangée.",
          "start": 13.264,
          "end": 18.714
        },
        {
          "cap": "Il s'appelait Alan Turing.",
          "start": 18.834,
          "end": 20.322
        }
      ],
      "start": 8.681,
      "end": 20.422,
      "duration": 11.741,
      "beats": [
        0.25,
        4.583,
        10.153
      ],
      "beatEnds": [
        4.463,
        10.033,
        11.641
      ]
    },
    {
      "id": "02-boucle",
      "index": 2,
      "lines": [
        {
          "cap": "Tu connais peut-être le film.",
          "start": 20.672,
          "end": 23.534
        },
        {
          "cap": "Tu connais peut-être Enigma.",
          "start": 23.654,
          "end": 25.36
        },
        {
          "cap": "Mais l'histoire complète est plus étrange.",
          "start": 25.48,
          "end": 27.441
        },
        {
          "cap": "Et plus dure.",
          "start": 27.561,
          "end": 28.442
        },
        {
          "cap": "Aujourd'hui, on la raconte du début.",
          "start": 28.562,
          "end": 30.562
        },
        {
          "cap": "Et à la fin, on reviendra sur cette pomme.",
          "start": 30.682,
          "end": 34.118
        },
        {
          "cap": "Parce que personne n'est d'accord sur ce qu'elle veut dire.",
          "start": 34.668,
          "end": 37.353
        }
      ],
      "start": 20.422,
      "end": 37.453,
      "duration": 17.031,
      "beats": [
        0.25,
        3.232,
        5.058,
        7.139,
        8.14,
