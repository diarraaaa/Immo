        10.447,
        13.144
      ],
      "beatEnds": [
        2.366,
        4.512,
        7.369,
        8.054,
        10.227,
        12.594,
        15.762
      ]
    },
    {
      "id": "03-christopher",
      "index": 3,
      "lines": [
        {
          "cap": "Londres, 23 juin 1912.",
          "start": 37.24,
          "end": 39.792
        },
        {
          "cap": "Alan Mathison Turing naît dans une famille de fonctionnaires de l'Empire britannique.",
          "start": 40.012,
          "end": 44.817
        },
        {
          "cap": "Son père travaille en Inde.",
          "start": 45.037,
          "end": 47.127
        },
        {
          "cap": "Alan et son frère grandissent souvent chez des familles d'accueil en Angleterre.",
          "start": 47.347,
          "end": 51.243
        },
        {
          "cap": "Très tôt, il est différent : passionné de chiffres et de chimie, indifférent au reste.",
          "start": 51.463,
          "end": 56.224
        },
        {
          "cap": "À l'école de Sherborne, un pensionnat chic du sud de l'Angleterre, on veut des latinistes.",
          "start": 56.444,
          "end": 61.247
        },
        {
          "cap": "Pas des scientifiques.",
          "start": 61.467,
          "end": 62.76
        },
        {
          "cap": "Son directeur écrit qu'il perd son temps dans une école comme la leur.",
          "start": 62.98,
          "end": 66.673
        },
        {
          "cap": "Alan est seul.",
          "start": 66.893,
          "end": 67.731
        },
        {
          "cap": "Jusqu'à Christopher Morcom.",
          "start": 67.951,
          "end": 69.799
        },
        {
          "cap": "Un élève un peu plus âgé, brillant, passionné d'astronomie.",
          "start": 70.019,
          "end": 73.923
        },
        {
          "cap": "Pour la première fois, quelqu'un parle sa langue.",
          "start": 74.143,
          "end": 76.977
        },
        {
          "cap": "Alan l'admire.",
          "start": 77.197,
          "end": 78.058
        },
        {
          "cap": "Il l'aime, sans doute.",
          "start": 78.278,
          "end": 79.707
        },
        {
          "cap": "Le 13 février 1930, Christopher meurt de la tuberculose.",
          "start": 79.927,
          "end": 85.191
        },
        {
          "cap": "Il a 18 ans.",
          "start": 85.411,
          "end": 86.314
        },
        {
          "cap": "Alan est dévasté.",
          "start": 86.534,
          "end": 87.604
        },
        {
          "cap": "Et il se pose une question qui ne le lâchera plus : qu'est-ce qu'un esprit ?",
          "start": 87.824,
          "end": 91.372
        },
        {
          "cap": "Est-ce que la pensée peut exister en dehors du corps ?",
          "start": 91.592,
          "end": 94.145
        },
        {
          "cap": "Garde cette question en tête.",
          "start": 94.365,
          "end": 95.746
        },
        {
          "cap": "Elle va revenir.",
          "start": 95.966,
          "end": 96.763
        }
      ],
      "start": 36.99,
      "end": 97.063,
      "duration": 60.073,
