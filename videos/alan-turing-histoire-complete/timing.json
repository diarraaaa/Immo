    {
      "id": "05-bletchley",
      "index": 5,
      "lines": [
        {
          "cap": "Septembre 1939.",
          "start": 165.886,
          "end": 169.248
        },
        {
          "cap": "La guerre éclate.",
          "start": 169.368,
          "end": 170.407
        },
        {
          "cap": "Turing rejoint un manoir discret au nord de Londres : Bletchley Park.",
          "start": 170.527,
          "end": 174.619
        },
        {
          "cap": "C'est le centre secret des décrypteurs britanniques.",
          "start": 174.739,
          "end": 177.346
        },
        {
          "cap": "Leur ennemi s'appelle Enigma.",
          "start": 177.466,
          "end": 178.943
        },
        {
          "cap": "La machine de chiffrement de l'armée allemande.",
          "start": 179.063,
          "end": 182.219
        },
        {
          "cap": "Des rotors, des fiches, des réglages qui changent chaque jour.",
          "start": 182.339,
          "end": 185.797
        },
        {
          "cap": "Le nombre de combinaisons possibles se compte en milliards de milliards.",
          "start": 185.917,
          "end": 189.97
        },
        {
          "cap": "Mais il faut rendre justice à quelqu'un.",
          "start": 190.09,
          "end": 193.284
        },
        {
          "cap": "Les premiers à avoir cassé Enigma, ce ne sont pas les Britanniques.",
          "start": 193.404,
          "end": 197.823
        },
        {
          "cap": "Ce sont des mathématiciens polonais, menés par Marian Rejewski, dès les années 1930.",
          "start": 197.943,
          "end": 202.927
        },
        {
          "cap": "En juillet 1939, dans une forêt près de Varsovie, ils transmettent tout leur travail aux Britanniques et aux Français.",
          "start": 203.047,
          "end": 209.392
        },
        {
          "cap": "Turing part de là.",
          "start": 209.512,
          "end": 211.422
        },
        {
          "cap": "Avec Gordon Welchman, il conçoit une machine bien plus puissante : la Bombe.",
          "start": 211.542,
          "end": 215.904
        },
        {
          "cap": "Une armoire bruyante, pleine de tambours qui tournent, et qui élimine les mauvais réglages à toute vitesse.",
          "start": 216.024,
          "end": 220.85
        },
        {
          "cap": "La première est installée en mars 1940.",
          "start": 220.97,
          "end": 225.36
        },
        {
          "cap": "Turing prend ensuite la tête du Hut 8, la baraque chargée du code de la marine allemande.",
          "start": 225.48,
          "end": 229.918
        },
        {
          "cap": "Le plus dur de tous.",
          "start": 230.038,
          "end": 231.383
        },
        {
          "cap": "Ce code protège les sous-marins qui coulent les convois de l'Atlantique.",
          "start": 231.503,
          "end": 234.781
        },
        {
          "cap": "Ces convois transportent la nourriture et les armes dont la Grande-Bretagne a besoin pour tenir.",
          "start": 234.901,
          "end": 240.024
        },
        {
          "cap": "En 1941, les décrypteurs commencent à lire les messages de la marine.",
          "start": 240.144,
          "end": 245.242
        },
        {
          "cap": "Mais ils manquent de tout.",
          "start": 245.362,
          "end": 248.373
        },
        {
          "cap": "De personnel.",
          "start": 248.493,
          "end": 249.311
        },
        {
          "cap": "De machines.",
          "start": 249.431,
          "end": 250.177
        },
        {
          "cap": "Alors, en octobre 1941, Turing et trois collègues font quelque chose d'inouï.",
          "start": 250.297,
          "end": 256.219
        },
        {
          "cap": "Ils écrivent directement à Winston Churchill.",
          "start": 256.339,
          "end": 259.027
        },
        {
          "cap": "Sans passer par leurs chefs.",
          "start": 259.147,
          "end": 260.471
        },
        {
          "cap": "La réponse de Churchill tient en une étiquette rouge : « Action ce jour ».",
          "start": 260.591,
          "end": 265.555
        },
        {
          "cap": "Ils obtiennent ce qu'ils demandent.",
          "start": 265.675,
          "end": 268.542
        },
        {
          "cap": "Combien de vies ce travail a-t-il sauvées ?",
          "start": 268.662,
          "end": 271.035
        },
        {
          "cap": "Personne ne peut le chiffrer.",
          "start": 271.155,
          "end": 273.842
        },
        {
          "cap": "Selon Bletchley Park, il aurait raccourci la guerre de jusqu'à 2 ans.",
          "start": 273.962,
          "end": 278.519
        },
        {
          "cap": "C'est une estimation, et elle est débattue.",
          "start": 278.639,
          "end": 280.524
        },
        {
          "cap": "Mais une chose est sûre : pendant des décennies, presque personne n'a su ce que Turing avait fait.",
          "start": 280.644,
          "end": 285.947
        },
        {
          "cap": "Tout était classé secret.",
          "start": 286.067,
          "end": 289.077
        }
      ],
