    {
      "id": "04-enigma",
      "index": 3,
      "lines": [
        {
          "cap": "1939. War breaks out.",
          "hl": "War",
          "start": 25.102,
          "end": 27.541
        },
        {
          "cap": "The Nazis encrypt their messages with the Enigma machine.",
          "hl": "Enigma",
          "start": 27.681,
          "end": 30.811
        },
        {
          "cap": "159 quintillion possible settings.",
          "hl": "159 quintillion",
          "start": 30.951,
          "end": 33.958
        },
        {
          "cap": "And the settings change every single day.",
          "hl": "every single day",
