          "hl": "first computers",
          "start": 50.789,
          "end": 53.623
        },
        {
          "cap": "and asks a wild question:",
          "hl": "wild question",
          "start": 53.763,
          "end": 55.329
        },
        {
          "cap": "can a machine think?",
