    {
      "id": "03-machine",
      "index": 2,
      "lines": [
        {
          "cap": "In 1936, aged just 24,",
          "hl": "24",
          "start": 15.613,
          "end": 18.435
        },
        {
          "cap": "he imagined a machine that could run any program.",
          "hl": "any program",
          "start": 18.575,
          "end": 21.121
        },
        {
          "cap": "The Turing machine.",
          "hl": "Turing machine",
          "start": 21.261,
          "end": 22.45
        },
        {
          "cap": "The idea behind the modern computer.",
